# PUBLIC REPO = WHITELIST. Everything is private unless listed below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/patches/
/patches/*
!/patches/*.sh
!/patches/src/
!/build/
/build/*
!/build/args-android.gn
!/build/args-dev.gn
!/build/args-linux.gn
!/packaging/
/packaging/dev/
/packaging/snap/*.deb
/packaging/snap/*.snap
/packaging/snap/iris-version.txt
/packaging/snap/parts/
/packaging/snap/stage/
/packaging/snap/prime/
!/branding/
/branding/*
!/branding/icon/
/branding/icon/*
!/branding/icon/generated/
!/branding/icon/generated-android/
!/branding/icon/gen_android_icon.py
!/branding/icon/product_orb_16.icon
!/branding/icon/product_orb_24.icon
!/branding/icon/product_refresh_orb.icon
!/website/
!/adblock/
/adblock/*
!/adblock/build-ruleset.sh
!/adblock/prepare-extra-lists.py
!/adblock/lists/
/adblock/lists/extra-merged.txt
!/adblock/dist/
!/test/
!/keys/
/keys/*
!/keys/jegly-mldsa87.pub.pem
!/keys/jegly.asc
__pycache__/
*.pyc

# Private signing keys: never committed, even if a rule above matches them.
*.key.pem
*-private*
*secret*
*.rev
