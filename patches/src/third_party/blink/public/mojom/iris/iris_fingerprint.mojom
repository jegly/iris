module blink.mojom;

// Iris (Phase B4): what a site gets when it reads canvas pixels or audio samples.
enum IrisFingerprintMode {
  kProtected,  // tiny, stable per-site-per-session changes (default)
  kBlank,      // empty data
  kReal,       // unchanged
};

// Implemented in the browser per document (chrome/browser/iris/iris_fingerprint_host.cc).
interface IrisFingerprintHost {
  // Mode for the top-level site (Settings -> Site settings -> "Canvas and audio reading") and a seed that is
  // stable for that site until Iris restarts.
  [Sync] GetMode() => (IrisFingerprintMode mode, uint64 seed);

  // Settings -> Iris hardening -> "Block third-party requests", for this document's top-level site (false when the
  // switch is off or ads are allowed for the site). Asked at most once per document, on its first third-party request.
  [Sync] GetBlockThirdParty() => (bool block);
};
